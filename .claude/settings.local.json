{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(node -e ':*)",
      "Bash(wc -l src/*.js)",
      "Bash(timeout 15 node src/index.js)",
      "Bash(npx kill-port:*)",
      "Bash(taskkill //f //im node.exe)",
      "Bash(tasklist)",
      "Bash(wmic process:*)",
      "Bash(powershell -Command \"Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,Path,CommandLine | Format-List\")",
      "Bash(powershell:*)",
      "Bash(node src/index.js)"
    ]
  }
}
